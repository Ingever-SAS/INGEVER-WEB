# Variables de entorno para el envío de emails corporativos desde la
# Netlify Function "submit-form".
#
# Copia este archivo como referencia. NO subas el archivo `.env` real al
# repositorio (ya está excluido en .gitignore).
#
# Estas variables se configuran en Netlify:
#   Site → Site settings → Environment variables → "Add a variable"
#   (Site scope: All scopes)

# --- Gmail API + OAuth 2.0 --------------------------------------------
# El envío de correo se hace con Gmail API usando OAuth 2.0.
# NO se usa SMTP, App Password ni autenticación por contraseña.
#
# Crear el OAuth Client "Web application" en Google Cloud:
#   1) APIs & Services → Library → habilitar "Gmail API".
#   2) APIs & Services → OAuth consent screen → tipo Internal.
#   3) APIs & Services → Credentials → Create OAuth client ID
#      (Application type: Web application).
#   4) Authorized redirect URI: http://localhost:53682
#      (solo se usa para generar el refresh token la primera vez).
GOOGLE_OAUTH_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-tu_client_secret

# Refresh token de larga duración. Se genera UNA sola vez con:
#   node scripts/get-refresh-token.js
# Debe ser de la cuenta webmaster@ingeverasociados.com.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Cuenta que envía los correos (debe coincidir con la cuenta del refresh token).
MAIL_FROM_ADDRESS=webmaster@ingeverasociados.com

# Nombre visible del remitente.
MAIL_FROM_NAME=Ingever Asociados S.A.S.

# --- Destinatarios por formulario -------------------------------------
# A dónde llega cada tipo de solicitud.
COTIZACIONES_EMAIL=ingenieria@ingeverasociados.com
EMPLEO_EMAIL=talentohumano@ingeverasociados.com

# --- Origen del sitio (para reenviar a Netlify Forms) -----------------
# Dominio público del sitio. Netlify Forms espera recibir el form en su
# propio dominio público.
SITE_ORIGIN=https://ingeverasociados.com
